# Configuração do Atria para o docker-compose.yml de referência ([project/self-hosting-03]).
# Copie para `.env` e troque os valores marcados. Nenhum valor aqui é um segredo real.
# Guia completo: docs/self-hosting.md.

# --- PostgreSQL ---
# Banco, usuário e senha criados na primeira subida do serviço `db`.
POSTGRES_DB=atria
POSTGRES_USER=atria
# Troque por uma senha longa e aleatória (ex.: `openssl rand -base64 24`).
POSTGRES_PASSWORD=troque-esta-senha

# --- Obrigatórias ---
# Conexão do app com o banco; use a mesma senha de POSTGRES_PASSWORD. O host `db` é o serviço do compose.
ATRIA_DATABASE_URL=postgres://atria:troque-esta-senha@db:5432/atria
# Endereço pelo qual as pessoas acessam o Atria. Com `https://`, o cookie de sessão
# leva `Secure` e as respostas levam HSTS.
ATRIA_PUBLIC_URL=https://atria.example.com

# --- Chave de criptografia ---
# Arquivo no host com a chave que cifra o diário e as notas em repouso, montado como segredo.
# Gere uma vez com:
#   mkdir -p secrets && openssl rand -base64 32 > secrets/atria_key && chmod 644 secrets/atria_key
# ATENÇÃO: sem esta chave o diário e as notas ficam ilegíveis para sempre. Guarde uma
# cópia fora do servidor, separada do backup do banco, e nunca a coloque no repositório.
ATRIA_KEY_PATH=./secrets/atria_key

# --- Rede ---
# Porta do app no host (só em 127.0.0.1, para o proxy reverso).
ATRIA_HOST_PORT=8080
# Proxies cujos cabeçalhos X-Forwarded-* são aceitos, em CIDR ou IP separados por vírgula.
# Vazio: nenhum proxy é confiável. Com o proxy no host, use a faixa do gateway do Docker,
# por exemplo `172.16.0.0/12`.
ATRIA_TRUSTED_PROXIES=

# --- Logs ---
# Nível dos logs em JSON: error, warn, info, debug ou trace.
ATRIA_LOG_LEVEL=info

# --- Opcionais: e-mail (SMTP) ---
# Sem ATRIA_SMTP_HOST o envio de e-mail fica desligado e o admin gera o link de
# redefinição de senha.
ATRIA_SMTP_HOST=
ATRIA_SMTP_PORT=587
ATRIA_SMTP_USER=
# Caminho, dentro do container, do arquivo com a senha do SMTP (monte-o como volume ou segredo).
ATRIA_SMTP_PASSWORD_FILE=
ATRIA_SMTP_FROM=

# --- Opcionais: Web Push ---
# Caminho, dentro do container, do arquivo com a chave VAPID. Vazio: só a notificação
# dentro do app; o Web Push depende do serviço de push do navegador e da internet.
ATRIA_WEB_PUSH_VAPID_KEY_FILE=

# --- Definidas pelo docker-compose.yml e pela imagem ---
# Não precisam ser alteradas: o docker-compose.yml (e a imagem, no caso do endereço)
# já as definem com estes valores.
# ATRIA_BIND_ADDRESS=0.0.0.0:8080
# ATRIA_ENCRYPTION_KEY_FILE=/run/secrets/atria_key
# ATRIA_STORAGE_PATH=/data/files
