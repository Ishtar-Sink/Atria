  "query": "UPDATE milestones SET title = COALESCE($4, title), position = COALESCE($5, position), completed_at = CASE WHEN $6::boolean IS NULL THEN completed_at WHEN $6 THEN COALESCE(completed_at, $8) ELSE NULL END, visibility = COALESCE($7, visibility), updated_at = $8 WHERE id = $1 AND goal_id = $2 AND owner_id = $3 AND deleted_at IS NULL RETURNING id, owner_id, visibility AS \"visibility: _\", goal_id, title, position, completed_at AS \"completed_at: _\", created_at AS \"created_at: _\", updated_at AS \"updated_at: _\", deleted_at AS \"deleted_at: _\"",
