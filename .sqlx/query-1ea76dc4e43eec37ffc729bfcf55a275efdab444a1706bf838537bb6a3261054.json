{
  "db_name": "PostgreSQL",
  "query": "SELECT b.id, b.owner_id, b.visibility AS \"visibility: _\", b.title, b.author, b.publisher, b.page_count, b.tags, b.reading_status, b.cover_file_id, b.pdf_file_id, b.created_at AS \"created_at: _\", b.updated_at AS \"updated_at: _\", COALESCE((SELECT SUM(s.pages_read) FROM reading_sessions s WHERE s.book_id = b.id AND s.owner_id = b.owner_id), 0)::bigint AS \"pages_read_total!\" FROM books b WHERE b.owner_id = $1 AND b.deleted_at IS NULL AND ($2::text IS NULL OR b.visibility = $2) AND ($3::text IS NULL OR $3 = ANY(b.tags)) AND ($4::text IS NULL OR b.search_vector @@ websearch_to_tsquery('portuguese', library_unaccent($4))) AND ($5::timestamptz IS NULL OR (b.created_at, b.id) < ($5, $6)) AND ($8::text IS NULL OR b.reading_status = $8) ORDER BY b.created_at DESC, b.id DESC LIMIT $7",
