  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", kind, account_id, category_id, expected_amount, gross_amount, adjustments AS \"adjustments: _\", currency, rule AS \"rule: _\", description, last_closed_on AS \"last_closed_on: _\", created_at AS \"created_at: _\", updated_at AS \"updated_at: _\" FROM recurring_transactions WHERE owner_id = $1 AND deleted_at IS NULL AND ($2::uuid IS NULL OR id > $2) AND ($3::text IS NULL OR finance_unaccent(lower(description)) LIKE '%' || finance_unaccent(lower($3)) || '%' ESCAPE '\\') ORDER BY id LIMIT $4",
