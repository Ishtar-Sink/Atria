{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id, g.owner_id, g.visibility AS \"visibility: _\", g.title, g.description, g.deadline AS \"deadline: _\", g.status AS \"status: _\", g.labels, g.created_at AS \"created_at: _\", g.updated_at AS \"updated_at: _\", m.total AS \"milestone_count!\", m.done AS \"completed_milestone_count!\" FROM goals g CROSS JOIN LATERAL (SELECT count(*) AS total, count(completed_at) AS done FROM milestones WHERE goal_id = g.id AND owner_id = $1 AND deleted_at IS NULL) m WHERE g.id = $2 AND g.owner_id = $1 AND g.deleted_at IS NULL",
