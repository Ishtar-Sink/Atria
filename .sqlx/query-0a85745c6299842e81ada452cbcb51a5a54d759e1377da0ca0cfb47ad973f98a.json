  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", kind, account_id, category_id, description, expected_amount, expected_date AS \"expected_date: _\", settled_amount, settled_at AS \"settled_at: _\", difference_amount, difference_kind, currency, generated_from, occurrence_date AS \"occurrence_date: _\", created_at AS \"created_at: _\", updated_at AS \"updated_at: _\" FROM transactions WHERE owner_id = $1 AND generated_from = $2 AND deleted_at IS NULL AND ($3::date IS NULL OR occurrence_date < $3 OR (occurrence_date = $3 AND id > $4)) ORDER BY occurrence_date DESC, id LIMIT $5",
