{
  "db_name": "PostgreSQL",
  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", title, description, due_on AS \"due_on: _\", is_recurring, completed_at AS \"completed_at: _\", labels, created_at AS \"created_at: _\", updated_at AS \"updated_at: _\" FROM tasks WHERE owner_id = $1 AND deleted_at IS NULL AND ($2::boolean IS NULL OR (completed_at IS NOT NULL) = $2) AND ($3::boolean IS NULL OR is_recurring = $3) AND ($4::date IS NULL OR due_on >= $4) AND ($5::date IS NULL OR due_on <= $5) AND ($6::text IS NULL OR labels @> ARRAY[$6]::text[]) AND ($7::text IS NULL OR strpos(lower(title), lower($7)) > 0) AND ($8::timestamptz IS NULL OR (created_at, id) < ($8, $9)) ORDER BY created_at DESC, id DESC LIMIT $10",
