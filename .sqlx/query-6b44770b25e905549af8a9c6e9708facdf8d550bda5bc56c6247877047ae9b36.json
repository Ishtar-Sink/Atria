  "query": "SELECT b.id, b.owner_id, b.visibility AS \"visibility: _\", b.title, b.author, b.publisher, b.page_count, b.tags, b.reading_status, b.cover_file_id, b.pdf_file_id, b.created_at AS \"created_at: _\", b.updated_at AS \"updated_at: _\", COALESCE((SELECT SUM(s.pages_read) FROM reading_sessions s WHERE s.book_id = b.id AND s.owner_id = b.owner_id), 0)::bigint AS \"pages_read_total!\" FROM books b WHERE b.owner_id = $1 AND b.id = $2 AND b.deleted_at IS NULL",
