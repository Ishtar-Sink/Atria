{
  "db_name": "PostgreSQL",
  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", source_type, source_id, target_type, target_id, created_at AS \"created_at: _\", updated_at AS \"updated_at: _\" FROM links WHERE owner_id = $1 AND ((source_type = $2 AND source_id = $3) OR (target_type = $2 AND target_id = $3)) AND ($4::text IS NULL OR (CASE WHEN source_type = $2 AND source_id = $3 THEN target_type ELSE source_type END) = $4) AND ($5::timestamptz IS NULL OR (created_at, id) < ($5, $6)) ORDER BY created_at DESC, id DESC LIMIT $7",
