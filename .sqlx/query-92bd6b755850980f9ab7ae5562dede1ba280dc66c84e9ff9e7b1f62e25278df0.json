{
  "db_name": "PostgreSQL",
  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", from_account_id, to_account_id, amount, currency, transferred_on AS \"transferred_on: _\", description, created_at AS \"created_at: _\", updated_at AS \"updated_at: _\" FROM transfers WHERE owner_id = $1 AND deleted_at IS NULL AND ($2::uuid IS NULL OR id > $2) AND ($3::date IS NULL OR transferred_on >= $3) AND ($4::date IS NULL OR transferred_on <= $4) AND ($5::text IS NULL OR finance_unaccent(lower(description)) LIKE '%' || finance_unaccent(lower($5)) || '%' ESCAPE '\\') ORDER BY id LIMIT $6",
