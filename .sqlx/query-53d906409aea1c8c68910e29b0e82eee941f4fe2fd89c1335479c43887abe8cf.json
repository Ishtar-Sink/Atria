  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", title_ciphertext, body_ciphertext, created_at AS \"created_at: _\", updated_at AS \"updated_at: _\", deleted_at AS \"deleted_at: _\" FROM notes WHERE owner_id = $1 AND deleted_at IS NULL AND ($2::text IS NULL OR visibility = $2) AND ($3::timestamptz IS NULL OR (updated_at, id) < ($3, $4)) ORDER BY updated_at DESC, id DESC LIMIT $5",
