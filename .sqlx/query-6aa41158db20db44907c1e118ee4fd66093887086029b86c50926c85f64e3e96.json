  "query": "INSERT INTO milestones (id, owner_id, visibility, goal_id, title, position, created_at, updated_at) VALUES ($1, $2, $3, $4, $5, COALESCE($6, (SELECT COALESCE(MAX(position) + 1, 0) FROM milestones WHERE goal_id = $4 AND owner_id = $2 AND deleted_at IS NULL)), $7, $7) RETURNING id, owner_id, visibility AS \"visibility: _\", goal_id, title, position, completed_at AS \"completed_at: _\", created_at AS \"created_at: _\", updated_at AS \"updated_at: _\", deleted_at AS \"deleted_at: _\"",
