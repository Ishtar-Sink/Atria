  "query": "SELECT id, owner_id, visibility AS \"visibility: _\", url, title, channel, watch_status, tags, thumbnail_file_id, created_at AS \"created_at: _\", updated_at AS \"updated_at: _\" FROM videos WHERE owner_id = $1 AND deleted_at IS NULL AND ($2::text IS NULL OR visibility = $2) AND ($3::text IS NULL OR $3 = ANY(tags)) AND ($4::text IS NULL OR search_vector @@ websearch_to_tsquery('portuguese', library_unaccent($4))) AND ($5::timestamptz IS NULL OR (created_at, id) < ($5, $6)) AND ($8::text IS NULL OR watch_status = $8) ORDER BY created_at DESC, id DESC LIMIT $7",
